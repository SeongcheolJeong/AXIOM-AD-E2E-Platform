# Local development only. Copy to .env and export values before starting.
# The launcher does not silently read arbitrary shell files.
ADE2E_DATA_DIR=./data
# Optional bearer token for non-public data endpoints. Keep loopback binding.
# ADE2E_API_TOKEN=replace-with-a-long-random-value

# Optional experimental CARLA adapter: install integrations/carla first.
# Use an exclusive disposable CARLA server; no server is bundled.
# API host (works without the carla Python wheel):
# ADE2E_CARLA_WORKER_URL=http://127.0.0.1:8100
# ADE2E_CARLA_WORKER_TOKEN=replace-with-a-long-random-value
# On the dedicated worker host only:
# ADE2E_CARLA_HOST=127.0.0.1
# ADE2E_CARLA_PORT=2000
# ADE2E_CARLA_EXCLUSIVE=1
# ADE2E_CARLA_CAPTURE=1
# Required for platform adapter 0.5 execution identities and recovery.
# Preserve this private worker store across release/process restarts.
# ADE2E_CARLA_EXECUTION_STORE=/absolute/private/persistent/carla-executions
